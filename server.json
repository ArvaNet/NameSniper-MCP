{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "pro.namesniper/namesniper",
  "title": "NameSniper",
  "description": "Monitor taken usernames and get alerted when they drop, plus handle, domain, and trademark checks.",
  "version": "1.1.1",
  "websiteUrl": "https://namesniper.pro",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://namesniper.pro/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "namesniper-mcp",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "repository": {
    "url": "https://github.com/ArvaNet/NameSniper-MCP",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/ArvaNet/NameSniper-MCP/main/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ]
}
